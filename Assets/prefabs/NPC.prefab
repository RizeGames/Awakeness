--- !u!114 &4317686238660451255
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1953469155290332134}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cafec85d3550c21418aab8808c0b600d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  afterDoTaskDialogue:
    dialogueName: after
    dialougeLines:
    - character:
        characterName: RX-50
      line: You found the key faster i expected.
    - character:
        characterName: RX-50
      line: Take this thing , It will help you to move objects that have a magnetic
        field.
    - character:
        characterName: RX-50
      line: I will go now maybe we will meet again , Thank you for your help.
  beforeDoTaskDialogue:
    dialogueName: before
    dialougeLines:
    - character:
        characterName: RX-50
      line: I have been waitting so long for someone to come that i thought none
        of us were left here.
    - character:
        characterName: RX-50
      line: It seems we have been abandoned for some reason i don't know , The lab
        was warm unlike this place.
    - character:
        characterName: RX-50
      line: All i remember is being trapped in this cage and wanting to get out ,
        Go find the key and i will give you something to help you escape from this
        place.
  cageDoor: {fileID: 0}
